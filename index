<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Fenris Apps</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0c2e4f;
    --teal: #21abad;
    --green: #8cc641;
    --bg: #f3f6f9;
    --surface: #ffffff;
    --ink: #0c2e4f;
    --muted: #5a6f84;
    --line: #dde5ec;
    --hover: #e9f5f5;
    --band: #0c2e4f;
    --band-ink: #ffffff;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #071b2f;
      --surface: #0e2640;
      --ink: #e8eef4;
      --muted: #9bb0c4;
      --line: #1d3a58;
      --hover: #123a4a;
      --band: #0a2440;
      --band-ink: #ffffff;
    }
  }
  :root[data-theme="dark"] {
    --bg: #071b2f;
    --surface: #0e2640;
    --ink: #e8eef4;
    --muted: #9bb0c4;
    --line: #1d3a58;
    --hover: #123a4a;
    --band: #0a2440;
    --band-ink: #ffffff;
  }
  *, *::before, *::after { box-sizing: inherit; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "Instrument Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  header {
    background: var(--band);
    color: var(--band-ink);
    padding: 2.5rem 1.5rem 4.5rem;
    position: relative;
    overflow: hidden;
  }
  /* three brand stripes along the bottom edge of the band */
  header::after {
    content: "";
    position: absolute; left: 0; right: 0; bottom: 0; height: 6px;
    background: linear-gradient(90deg, var(--teal) 0 60%, var(--green) 60% 100%);
  }
  .wrap { max-width: 64rem; margin: 0 auto; }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .sub { margin: .5rem 0 0; color: #b9cadb; font-size: 1rem; }

  .search {
    max-width: 64rem;
    margin: -2rem auto 0;
    padding: 0 1.5rem;
    position: relative;
    z-index: 1;
  }
  .search label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .search-box {
    display: flex; align-items: center; gap: .75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: .9rem 1.1rem;
    box-shadow: 0 8px 24px rgba(12, 46, 79, .12);
  }
  .search-box svg { flex: none; color: var(--muted); }
  .search input {
    flex: 1; min-width: 0;
    border: 0; outline: 0; background: transparent;
    font: inherit; font-size: 1.05rem; color: var(--ink);
  }
  .search input::placeholder { color: var(--muted); }
  .search-box:focus-within { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(33,171,173,.25), 0 8px 24px rgba(12,46,79,.12); }
  kbd {
    font: inherit; font-size: .8rem; color: var(--muted);
    border: 1px solid var(--line); border-radius: 6px; padding: .05rem .45rem;
  }

  main { max-width: 64rem; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  section + section { margin-top: 2.25rem; }
  h2 {
    margin: 0 0 .9rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: .75rem;
  }
  .app {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: .7rem;
    padding: 1.4rem .75rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    color: inherit; text-decoration: none;
    transition: border-color .15s, background-color .15s;
  }
  .app:hover { border-color: var(--teal); background: var(--hover); }
  .app:focus-visible { outline: 3px solid var(--teal); outline-offset: 2px; }
  .app.top { border-color: var(--teal); }
  .icon {
    width: 3.5rem; height: 3.5rem; border-radius: 14px;
    display: grid; place-items: center;
    color: #fff; font-weight: 700; font-size: 1.5rem; letter-spacing: -0.02em;
  }
  .icon svg { width: 1.75rem; height: 1.75rem; }
  .icon { overflow: hidden; }
  .icon img { width: 100%; height: 100%; display: block; }
  .icon img.pad { width: 78%; height: 78%; margin: auto; }
  .icon:has(img.pad), .icon:has(img.frame) { box-shadow: inset 0 0 0 1px var(--line); }
  .name { font-weight: 600; font-size: .98rem; line-height: 1.25; }
  .host { font-size: .78rem; color: var(--muted); word-break: break-all; margin-top: -.45rem; }

  .empty { color: var(--muted); padding: 1rem 0; }
  footer { max-width: 64rem; margin: 0 auto; padding: 0 1.5rem 2.5rem; color: var(--muted); font-size: .85rem; }

  @media (prefers-reduced-motion: reduce) { .app { transition: none; } }
  @media (max-width: 480px) {
    header { padding: 2rem 1.25rem 4rem; }
    .search, main, footer { padding-left: 1.25rem; padding-right: 1.25rem; }
    .grid { grid-template-columns: repeat(2, 1fr); }
    kbd { display: none; }
  }
</style>
</head>
<body>
  <header>
    <div class="wrap">
      <h1>Fenris Apps</h1>
      <p class="sub">Everything you sign into, in one place. Bookmark this page.</p>
    </div>
  </header>

  <div class="search">
    <label for="q">Search apps</label>
    <div class="search-box">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder="Search apps" autocomplete="off">
      <kbd>/</kbd>
    </div>
  </div>

  <main id="apps"></main>

  <footer>Links open each app's sign-in page in a new tab.</footer>

<script>
/*
  To add or change an app, edit this list.
  group: which section it appears in
  color: tile background
  icon:  one of "globe", "book", "folder", "mail", "calendar", "hubspot", "zoominfo", "saleshandy", or leave empty to show the first letter
*/
const APPS = [
  { group: "Fenris",             name: "Fenris Website",      url: "https://fenrisd.com/",                                        color: "#ffffff", icon: "fenris" },
  { group: "Fenris",             name: "Fenris API Docs",     url: "https://documentation.fenrisd.com/",                          color: "#21abad", icon: "book" },
  { group: "Google Workspace",   name: "Gmail",               url: "https://mail.google.com/mail/u/0/",                           color: "#ffffff", icon: "gmail" },
  { group: "Google Workspace",   name: "Google Calendar",     url: "https://calendar.google.com/calendar/u/0/r",                  color: "#ffffff", icon: "gcal" },
  { group: "Google Workspace",   name: "Fenris Google Drive", url: "https://drive.google.com/drive/folders/0AMxmGHIGoflNUk9PVA",  color: "#ffffff", icon: "gdrive" },
  { group: "Sales and marketing", name: "HubSpot",            url: "https://app.hubspot.com/",                                    color: "#e8603c", icon: "hubspot" },
  { group: "Sales and marketing", name: "ZoomInfo",           url: "https://app.zoominfo.com/",                                   color: "#c8102e", icon: "zoominfo" },
  { group: "Sales and marketing", name: "SalesHandy",         url: "https://my.saleshandy.com/",                                  color: "#2f5bea", icon: "saleshandy" },
];

const LOGOS = {
  gcal: "data:image/png;base64,",
  gmail: "data:image/png;base64,",
  gdrive: "data:image/png;base64,",
  fenris: "data:image/png;base64,",
  hubspot: "data:image/png;base64,",
  zoominfo: "data:image/png;base64,",
  saleshandy: "data:image/png;base64,"
};

const PADDED = ["fenris", "gcal"];
const FRAMED = ["gmail", "gdrive"];

const ICONS = {
  globe:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>',
  book:     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/><path d="m9 8-2 2 2 2M15 8l2 2-2 2"/></svg>',
  folder:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z"/></svg>',
  mail:     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 7 8.5-7"/></svg>',
  calendar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
};

const root = document.getElementById("apps");
const input = document.getElementById("q");

function host(url) {
  try { return new URL(url).hostname.replace(/^www\./, ""); } catch { return url; }
}
function escapeHtml(s) {
  return s.replace(/[&<>"']/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c]));
}

function render(filter = "") {
  const f = filter.trim().toLowerCase();
  const list = APPS.filter(a => !f || a.name.toLowerCase().includes(f) || host(a.url).includes(f) || a.group.toLowerCase().includes(f));
  if (!list.length) {
    root.innerHTML = '<p class="empty">No apps match "' + escapeHtml(filter) + '". Clear the search to see everything.</p>';
    return;
  }
  const groups = [...new Set(list.map(a => a.group))];
  root.innerHTML = groups.map(g => `
    <section>
      <h2>${escapeHtml(g)}</h2>
      <div class="grid">
        ${list.filter(a => a.group === g).map(a => `
          <a class="app" href="${a.url}" target="_blank" rel="noopener noreferrer">
            <span class="icon" style="background:${a.color}" aria-hidden="true">${LOGOS[a.icon] ? `<img class="${PADDED.includes(a.icon) ? 'pad' : FRAMED.includes(a.icon) ? 'frame' : ''}" src="${LOGOS[a.icon]}" alt="">` : (ICONS[a.icon] || escapeHtml(a.name.charAt(0)))}</span>
            <span class="name">${escapeHtml(a.name)}</span>
            <span class="host">${escapeHtml(host(a.url))}</span>
          </a>`).join("")}
      </div>
    </section>`).join("");
  if (f) root.querySelector(".app")?.classList.add("top");
}

input.addEventListener("input", () => render(input.value));
input.addEventListener("keydown", e => {
  if (e.key === "Enter") {
    const first = root.querySelector(".app");
    if (first) window.open(first.href, "_blank", "noopener");
  }
  if (e.key === "Escape") { input.value = ""; render(); }
});
document.addEventListener("keydown", e => {
  if (e.key === "/" && document.activeElement !== input) { e.preventDefault(); input.focus(); }
});

render();
</script>
</body>
</html>
